@model ShopInternet.Areas.Admin.Models.VM.LoginViewModel
@{
    ViewData["Title"] = "Вхід";
}
<h2>Вхід</h2>

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-2">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="Password" class="control-label"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <label asp-for="RememberMe" class="form-check-label"></label>
                <input asp-for="RememberMe" class="form-check-input" />
            </div>
            <div class="form-group mt-2">
                <input type="submit" value="Вхід" class="btn btn-success" />
            </div>
        </form>
    </div>
</div>

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-5 text-center">
                <h3 class="card-title fw-bold mb-3">Ласкаво просимо</h3>
                <p class="text-muted mb-4">Авторизуйтеся за допомогою вашого Google-акаунту, щоб продовжити.</p>
                
                <form asp-action="LoginWithGoogle" asp-controller="Account" method="post">
                    <button type="submit" class="btn btn-outline-dark w-100 d-flex align-items-center justify-content-center gap-2 py-2">
                        <!-- SVG іконка Google -->
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-google" viewBox="0 0 16 16">
                            <path d="M15.545 6.558a9.4 9.4 0 0 1 .139 1.626c0 2.434-.87 4.492-2.384 5.885h.002C11.978 15.292 10.158 16 8 16A8 8 0 1 1 8 0c2.158 0 3.972.79 5.374 2.13l-2.208 2.208C10.118 3.322 9.178 3 8 3c-2.76 0-5 2.24-5 5s2.24 5 5 5c3.2 0 4.42-2.26 4.62-3.414H8v-3h7.545z"/>
                        </svg>
                        Увійти через Google
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>


